// ============================================================================
// AI 字体训练参数持久化配置文件 (JSONC)
// ----------------------------------------------------------------------------
// 本文件由前端训练页自动读写：
//   - 刷新页面  → GET  /api/train/config 读取，恢复所有输入框
//   - 修改参数  → POST /api/train/config 写入（input/change 事件自动触发）
//   - 「保存配置」按钮 → 手动立即写盘
// 注释格式：支持 // 行注释 和 /* 块注释 */（用 json5 库解析，见 app.py）
// ============================================================================

{
  // ===== 一、路径配置 =====

  "baseCheckpoint": "G:\\Projects\\projects_ai\\gaudi-ai-font-tool\\model\\zi2zi-JiT-B-16.pth",
  // ↑ 基础模型 = 预训练权重 (2.15GB, 已 gitignore 不随仓库分发)
  //   从 GitHub Release v1.0 分片下载后合并得到
  //   下载参考：installer/scripts/download_model.py

  "sourceFont": "C:\\Windows\\Fonts\\simfang.ttf",
  // ↑ 源字体 = source 通道标准字形（训练复合图左 1/4 用它渲染，告诉模型「要生成哪个字」）
  //   ★必须字形完整，且与生字侧 gen_chars.py 的 SOURCE_FONT 保持一致
  //   推荐 仿宋 simfang.ttf（2.85万字）；不要用 font/default.ttf（赵孟頫楷书，
  //   字形不全→约 27% 的 source 通道为空白，且部分字渲染成繁体形态，影响训练）

  "refFont": "",
  // ↑ 学习字库 TTF（可选）
  //   传统模式用：填了 ref_font 但没填 images_dir 时，从它渲染 target 字形
  //   images_dir 模式（推荐）下留空即可

  "imagesDir": "G:\\Projects\\projects_ai\\gaudi-font-preprocess\\data\\sessions\\f00b32702e636da1f6f464db4edbfa3c\\exported\\20260910_013320",
  // ↑ 字形素材目录（images_dir 模式必填）★核心
  //   指向 gaudi-font-preprocess「导出训练包」生成的 PNG 目录，例如：
  //   G:\...\gaudi-font-preprocess\data\sessions\<hash>\exported\<时间戳>
  //   要求目录内含 uniXXXX[_NN].png 命名的字形图（白底黑字, 512×512）
  //   后端 _scan_images_dir 会自动找同目录的 source_map.json 或按文件名解析

  "outputDir": "G:\\Projects\\projects_ai\\gaudi-ai-font-tool\\model\\run",
  // ↑ 输出目录 = 训练产物根目录（已 gitignore）
  //   每次训练自动建子目录 train_images_<时间戳>/，内含:
  //     001_font/*.png   (1024×256 复合训练图)
  //     test.npz          (门禁文件, 训练不消费)
  //     checkpoint-last.pth (训练完的模型, 生成页用这个)
  //     checkpoint-best.pth

  "lastCheckpoint": "",
  // ↑ 继续训练 / 测试生成用的 checkpoint 路径（UI 用，训练脚本不读它）
  //   训练完成后前端会自动填入 <outputDir>/checkpoint-last.pth

  "resumeFrom": "G:\\Projects\\projects_ai\\gaudi-ai-font-tool\\model\\run\\train_images_20260911_021429\\checkpoint-last.pth",
  // ↑ ★训练脚本专用的续训入口（scripts/train_lora.py）
  //   非空 = 续训模式：跳过 prepare，复用该 checkpoint 所在批次继续训
  //   留空 = 新建训练：prepare 新批次，从 baseCheckpoint 从头训
  //   例：G:\...\model\run\train_images_20260910_160142\checkpoint-last.pth

  // ===== 二、训练超参 =====

  "epochs": 30,
  // ↑ 训练轮数
  //   冒烟测试: 1   |   正式训练(318字): 50 建议
  //   单轮 ~16s/5字(1060)，正式 50 epoch 约 4-8 小时

  "batchSize": 4,
  // ↑ 批大小（★GTX 1060 6GB 硬上限 = 4）
  //   batch=64 会触发 CUDA OOM 段错误(退出码 0xC0000005)
  //   6GB 卡用户务必 ≤4; 显存更大可试 8/16

  "lr": "6.25e-6",
  // ↑ 学习率（留空 = 引擎默认）
  //   留空: 引擎按「线性缩放规则」算 lr = blr × batchSize / 256（blr=5e-5, 锚点 batch=256）
  //         batchSize=4 → 5e-5 × 4/256 = 7.81e-07（小 batch 被压到 1/64, 可能收敛不足）
  //   填值: 绝对学习率, 完全绕开缩放（★改 batchSize 时它不变, 需自己同步调整）
  //         换算参考（线性）: lr = 1.953e-07 × batchSize
  //           batch   4 → 7.81e-07     16 → 3.13e-06     64 → 1.25e-05    256 → 5.00e-05
  //         小 batch 下更合理的平方根缩放: lr = 5e-5 × √(batchSize/256)
  //           batch   4 → 6.25e-06     16 → 1.25e-05     64 → 2.50e-05
  //   升大显存后：把本字段清空即自动按新 batchSize 缩放（大 batch 下线性缩放本就是对的）

  "lrSchedule": "cosine",
  // ↑ 学习率调度: "constant"=全程恒定（引擎默认）| "cosine"=warmup 后余弦衰减到 minLr
  //   恒定 lr + 已收敛 → loss 在极限环里来回震荡
  //   （本项目实测周期约 10 轮, 在 0.0328~0.0358 之间规律重复, "哪轮最好"纯属偶然）
  //   cosine 让后期 lr 趋近 0, 模型能沉到环内更低的一点
  //   引擎固定 warmupEpochs=5（前 5 轮从 0 线性爬升到 lr, 之后才开始衰减）

  "minLr": 0,
  // ↑ cosine 衰减的终点 lr（仅 lrSchedule="cosine" 时生效）
  //   0 = 衰减到 0（最后一轮几乎不再更新, 相当于取终点权重）

  "loraR": 32,
  // ↑ LoRA rank（低秩分解维度，越大容量越大但更吃显存/易过拟合）

  "loraAlpha": 32,
  // ↑ LoRA alpha（缩放系数, alpha/r 即学习强度; 默认与 r 相等 = 缩放 1）

  "cfg": 2.6,
  // ↑ classifier-free guidance 强度（训练时用, 越高生成越贴风格）

  "numFonts": 1000,
  // ↑ 字体数（★必须 ≥ 1000, 与预训练权重 font_embedding shape 匹配）
  //   若设 1 会报: size mismatch for net.y_embedder.font_embedding.weight
  //   实际训练数据集只有 1 个字体, 但参数需对齐预训练 1000 类

  "numChars": 200000,
  // ↑ 字符数上限（引擎内部用 num_chars 分配, 数据集小于此值自动忽略）

  "maxCharsPerFont": 10000,
  // ↑ 单字体最大字符数（兜底限制, 防止异常数据集拖垮内存）

  "numWorkers": 0,
  // ↑ 数据加载子进程数（单 GPU 用 0 最稳; Windows 下 >0 可能不稳定）

  "saveLastFreq": 1,
  // ↑ 每隔 N 个 epoch 存一次 checkpoint-last.pth（1=每轮都存, 中断最多丢 1 epoch）

  // ===== 三、准备数据：取字数量 =====

  "charCountMode": "all",
  // ↑ 取字模式: "800"=800字 | "3000"=3000字 | "all"=全部(推荐,自动跟随导入字形数) | "custom"=自定义

  "charCountCustom": 318,
  // ↑ 当 charCountMode="custom" 时, 用这个数量取前 N 个字

  // ===== 四、继续训练 =====

  "continueEpochs": 24
  // ↑ 点「继续训练」时追加的轮次数（在已有 checkpoint-last.pth 基础上续训）
}
